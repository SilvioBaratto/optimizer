# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/optimizer_db

# FRED (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Left commented on purpose: a placeholder value would pass the "key is set"
# check and fail later with an opaque 400 instead of a clear "key required".
# FRED_API_KEY=

# Trading 212 (HTTP Basic auth: Base64(API_KEY:SECRET_KEY) — both required)
# Get your key from: Trading 212 app > Settings > API
# Mode: "live" for real account, "demo" for paper trading account
# IMPORTANT: API keys are environment-scoped — a Demo key only works with mode=demo,
#            a Live key only works with mode=live. You cannot cross-use them.
# Optional add-on: the universe is built from the yfinance Screener either way.
# Absent => the t212_annotate step skips without claiming a job slot, so
#           instruments carry no Trading 212 ticker. Keep both keys commented
#           until you have real values — a placeholder counts as "set".
# TRADING_212_API_KEY=
# TRADING_212_SECRET_KEY=
TRADING_212_MODE=live

# Prometheus metrics port. docker-compose publishes this same port on the host and
# the container healthcheck probes it, so one value moves all three.
METRICS_PORT=9000

# Discord/Slack-compatible webhook, POSTed on job failure (optional).
NOTIFICATION_WEBHOOK_URL=

# Il Sole 24 Ore and Trading Economics are scraped from HTML and need no API key.
# Scheduler cadence: see SCHEDULER_* in app/config.py.
