# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/optimizer_db

# FRED (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Left commented on purpose: a placeholder value would pass the "key is set"
# check and fail later with an opaque 400 instead of a clear "key required".
# FRED_API_KEY=

# Trading 212 (HTTP Basic auth: Base64(API_KEY:SECRET_KEY) — both required)
# Get your key from: Trading 212 app > Settings > API
# Mode: "live" for real account, "demo" for paper trading account
# IMPORTANT: API keys are environment-scoped — a Demo key only works with mode=demo,
#            a Live key only works with mode=live. You cannot cross-use them.
# Optional add-on: the universe is built from the yfinance Screener either way.
# Absent => the t212_annotate step skips without claiming a job slot, so
#           instruments carry no Trading 212 ticker. Keep both keys commented
#           until you have real values — a placeholder counts as "set".
# TRADING_212_API_KEY=
# TRADING_212_SECRET_KEY=
TRADING_212_MODE=live

# Prometheus metrics port. docker-compose publishes this same port on the host and
# the container healthcheck probes it, so one value moves all three.
METRICS_PORT=9000

# Discord/Slack-compatible webhook, POSTed on job failure (optional).
NOTIFICATION_WEBHOOK_URL=

# Il Sole 24 Ore and Trading Economics are scraped from HTML and need no API key.

# ---------------------------------------------------------------------------
# Optional tuning. Everything below is commented out at its built-in default
# (app/config.py is the source of truth); uncomment a line to change it.
# ---------------------------------------------------------------------------

# Connection pool and server-side caps (milliseconds, 0 = off). A writer queued
# behind another transaction's row lock fails after LOCK_TIMEOUT instead of
# pinning a pooled connection; STATEMENT_TIMEOUT stays off because it would
# cancel legitimate bulk writes.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=3600
# DATABASE_POOL_PRE_PING=true
# DATABASE_POOL_RESET_ON_RETURN=rollback
# DATABASE_ECHO=false
# DATABASE_LOCK_TIMEOUT_MS=60000
# DATABASE_STATEMENT_TIMEOUT_MS=0

# Logging and monitoring. LOG_FORMAT is json or text; ENABLE_METRICS=false also
# removes the container healthcheck target.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# ENABLE_METRICS=true
# ENVIRONMENT=development

# Scheduler cadence, 5-field cron in UTC. Use weekday names (sat): APScheduler
# numbers days 0=Mon..6=Sun, so a bare 0 fires on Monday. UNIVERSE_BUILD must
# precede WEEKLY_REFETCH, which must precede MARKET_WIDE.
# SCHEDULER_DAILY_PIPELINE_CRON="0 7 * * *"
# SCHEDULER_MIDDAY_NEWS_CRON="0 14 * * *"
# SCHEDULER_UNIVERSE_BUILD_CRON="0 2 * * sat"
# SCHEDULER_WEEKLY_REFETCH_CRON="0 3 * * sat"
# SCHEDULER_MARKET_WIDE_CRON="0 4 * * sat"
# SCHEDULER_FRED_MONTHLY_CRON="0 8 1 * *"
# SCHEDULER_MISFIRE_GRACE_TIME_SECONDS=3600

# Job liveness. A job whose heartbeat is older than the orphan timeout is failed
# by the reaper (run exactly one daemon per database). Keep the stall timeout well
# above the longest legitimate silent stretch of any step; keep the container
# stop_grace_period above the drain timeout. ORPHAN_STRATEGY is fail or reclaim.
# SCHEDULER_HEARTBEAT_CADENCE_SECONDS=30
# SCHEDULER_ORPHAN_HEARTBEAT_TIMEOUT_SECONDS=300
# SCHEDULER_STEP_STALL_TIMEOUT_SECONDS=3600
# SCHEDULER_ORPHAN_STRATEGY=fail
# SCHEDULER_ORPHAN_MAX_RECLAIM_ATTEMPTS=3
# SCHEDULER_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# yfinance: per-call timeout, parallel workers for the daily step (1-16; 1 is the
# serial path), and the level of yfinance's own logger (it logs Yahoo's routine
# "no data" answers at ERROR, so it is hidden unless you set DEBUG).
# YFINANCE_REQUEST_TIMEOUT_SECONDS=30
# YFINANCE_FETCH_WORKERS=4
# YFINANCE_LOG_LEVEL=CRITICAL

# Directory holding the file-based secrets (one file per secret, named after the
# setting). Compose mounts them at /run/secrets; a non-empty file wins over .env.
# PORTOPT_SECRETS_DIR=/run/secrets
