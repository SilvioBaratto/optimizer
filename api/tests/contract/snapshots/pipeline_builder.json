{
  "CreateSessionResponse": {
    "description": "Returned by ``POST /sessions``.",
    "properties": {
      "sessionId": {
        "description": "UUID hex of the new session",
        "title": "Sessionid",
        "type": "string"
      }
    },
    "required": [
      "sessionId"
    ],
    "title": "CreateSessionResponse",
    "type": "object"
  },
  "StepPollResponse": {
    "description": "Returned by ``GET /sessions/{id}/steps/{step_id}``.",
    "properties": {
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      },
      "gateReason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Set by ``step_coverage_gate`` when the IS \u2229 OOS factor set falls below ``min_factors``.",
        "title": "Gatereason"
      },
      "progress": {
        "additionalProperties": true,
        "title": "Progress",
        "type": "object"
      },
      "result": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result"
      },
      "status": {
        "description": "pending | running | completed | failed",
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "status"
    ],
    "title": "StepPollResponse",
    "type": "object"
  },
  "StepRunResponse": {
    "description": "Returned by ``POST /sessions/{id}/steps/{step_id}`` (202 ACCEPTED).",
    "properties": {
      "job_id": {
        "description": "Unique job ID",
        "title": "Job Id",
        "type": "string"
      },
      "message": {
        "default": "",
        "description": "Human-readable status message",
        "title": "Message",
        "type": "string"
      },
      "status": {
        "description": "pending | running | completed | failed",
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "job_id",
      "status"
    ],
    "title": "StepRunResponse",
    "type": "object"
  }
}
