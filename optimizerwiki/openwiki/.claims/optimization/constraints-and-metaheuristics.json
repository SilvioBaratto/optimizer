    {
      "id": "claim_dad01109c41d4013a657a4317e48ced6",
      "statement": "The Jobst et al. model uses binary switches δ_i∈{0,1} where l_iδ_i≤x_i≤u_iδ_i forces x_i=0 when δ_i=0 and confines x_i to [l_i,u_i] when δ_i=1, so a lower bound l_i>0 realizes the minimum constraint and Σδ_i=K caps holdings, solved by branch-and-bound tree search.",
      "evidence": [
        {
          "resource": "repo://docs/06_constraints_and_metaheuristics.md#L190-L208",
