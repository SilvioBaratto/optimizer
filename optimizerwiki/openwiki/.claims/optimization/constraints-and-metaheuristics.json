        }
      ]
    },
    {
      "id": "claim_11e0237ed43e472cbc2443f109871e55",
      "statement": "Investors prefer positive skewness (the third moment), which indicates a fatter right tail so returns are more likely to exceed the mean.",
      "evidence": [
        {
          "resource": "repo://docs/06_constraints_and_metaheuristics.md#L232-L232",
          "version": "repo-lines-v1:sha256:3302589683e43ee49dc3545beb495f6380a2cc634aefc070c3adcaf801c17f94:"
