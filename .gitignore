# Portfolio Optimizer - Root .gitignore
# ============================================================

# ═══════════════════════════════════════════════════════════
# ENVIRONMENT FILES (NEVER COMMIT SECRETS)
# ═══════════════════════════════════════════════════════════

# All environment files at root
.env
.env.*
!.env.example

# ═══════════════════════════════════════════════════════════
# PYTHON
# ═══════════════════════════════════════════════════════════

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
venv/
env/
ENV/
.venv

# ═══════════════════════════════════════════════════════════
# IDE & EDITOR
# ═══════════════════════════════════════════════════════════

# VS Code (keep launch.json and other configs)
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# PyCharm
.idea/

# ═══════════════════════════════════════════════════════════
# OPERATING SYSTEM
# ═══════════════════════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
Icon

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ═══════════════════════════════════════════════════════════
# LOGS & TEMPORARY FILES
# ═══════════════════════════════════════════════════════════

*.log
logs/
*.tmp
*.temp
temp/
tmp/

# ═══════════════════════════════════════════════════════════
# DOCKER
# ═══════════════════════════════════════════════════════════

# Docker compose overrides
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes
docker-volumes/
volumes/

# ═══════════════════════════════════════════════════════════
# PROJECT SPECIFIC
# ═══════════════════════════════════════════════════════════

# Cache directories
.cache/
cache/
# ...but NOT the Trading212 ticker-cache source package (real code, not a build artifact)
!ingestion/app/services/universe/trading212/cache/
!ingestion/app/services/universe/trading212/cache/**
# ...except its build artifacts, which the `**` negation above would otherwise re-include
ingestion/app/services/universe/trading212/cache/__pycache__/

# Output files (keep structure, ignore generated files)
optimizer/outputs/*.csv
optimizer/outputs/*.png
optimizer/outputs/*.pdf
optimizer/outputs/*.json
optimizer/outputs/*.txt
!optimizer/outputs/.gitkeep

# Database files (local SQLite, if any)
*.db
*.sqlite
*.sqlite3

# Backup files
*.backup
*.bak
*.old

# SSL certificates and keys
*.pem
*.key
*.cert
*.crt

# Node modules (for frontend)
node_modules/

# Frontend build artifacts
frontend/dist/
frontend/.angular/

# Claude Code — local config stays out of git (settings.local.json, worktrees),
# but project skills are shared with the team and must be tracked.
.claude/*
!.claude/skills/
.claude/skills/**/evals/

# Playwright MCP
.playwright-mcp/

# Code generator
.code-generator/

# Ideas / scratch notes (local only)
ideas/

# Local planning & task tracking
todo/
plan/
script.md
linkedin.md
cli.md
reference/

graphify-out/manifest.json    # mtime-based, breaks after git clone
graphify-out/cost.json        # local only
graphify-out/cache/         # optional: commit for speed, skip to keep repo small

idea/
graphify-out/
