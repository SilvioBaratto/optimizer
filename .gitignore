# Portfolio Optimizer - Root .gitignore
# ============================================================

# Runtime agent workdir (staged theory tree, regenerated each startup)
fund/.runtime/

# Local scratch dir for Rankia data, not tracked
/rankia/

# fund-tui exports hold client data (capital, mandates, adviser free text). They go to
# FUND_EXPORT_DIR (./exports when mounted into the container); the name patterns catch
# the files older versions wrote into the working directory.
/exports/
audit-export-*.csv
ask-*.md
daily-brief-*.md

# ═══════════════════════════════════════════════════════════
# ENVIRONMENT FILES (NEVER COMMIT SECRETS)
# ═══════════════════════════════════════════════════════════

# All environment files at root
.env
.env.*
!.env.example

# Plaintext compose secrets rendered by `portopt start`, in any directory — a render
# that lands outside the root secrets/ must still never be committable.
**/secrets/

# ═══════════════════════════════════════════════════════════
# PYTHON
# ═══════════════════════════════════════════════════════════

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
venv/
env/
ENV/
.venv

# ═══════════════════════════════════════════════════════════
# IDE & EDITOR
# ═══════════════════════════════════════════════════════════

# VS Code (keep launch.json and other configs)
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# PyCharm
.idea/

# ═══════════════════════════════════════════════════════════
# OPERATING SYSTEM
# ═══════════════════════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
Icon

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ═══════════════════════════════════════════════════════════
# LOGS & TEMPORARY FILES
# ═══════════════════════════════════════════════════════════

*.log
logs/
*.tmp
*.temp
temp/
tmp/

# ═══════════════════════════════════════════════════════════
# DOCKER
# ═══════════════════════════════════════════════════════════

# Docker compose overrides
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes
docker-volumes/
volumes/

# ═══════════════════════════════════════════════════════════
# PROJECT SPECIFIC
# ═══════════════════════════════════════════════════════════

# Cache directories
.cache/
cache/

# Output files (keep structure, ignore generated files)
optimizer/outputs/*.csv
optimizer/outputs/*.png
optimizer/outputs/*.pdf
optimizer/outputs/*.json
optimizer/outputs/*.txt
!optimizer/outputs/.gitkeep

# Database files (local SQLite, if any)
*.db
*.sqlite
*.sqlite3

# Backup files
*.backup
*.bak
*.old

# SSL certificates and keys
*.pem
*.key
*.cert
*.crt

# Node modules (for frontend)
node_modules/

# Frontend build artifacts
frontend/dist/
frontend/.angular/

# Claude Code — local config stays out of git (settings.local.json, worktrees),
# but project skills are shared with the team and must be tracked.
.claude/*
!.claude/skills/
.claude/skills/**/evals/
# Local skill-eval scratch workspaces (not shared)
.claude/skills/skfolio-workspace/
.claude/skills/yfinance-workspace/

# Playwright MCP
.playwright-mcp/

# Code generator
.code-generator/

# Ideas / scratch notes (local only)
ideas/

# Local planning & task tracking
# The superpowers plugin writes its plan scratch to docs/superpowers/; keep it out of git.
docs/superpowers/
# Local design records (decisions, NFRs, test plan, integration notes): not published.
design/
todo/
plan/
/SPEC.md
/tasks/
script.md
linkedin.md
cli.md
reference/

graphify-out/manifest.json    # mtime-based, breaks after git clone
graphify-out/cost.json        # local only
graphify-out/cache/         # optional: commit for speed, skip to keep repo small

idea/
graphify-out/

# Machine-local CA bundle for corporate TLS inspection (yfinance/curl_cffi)
.certs/

# Local scratch workspace (not shared)
/thebull/
/scratch/
