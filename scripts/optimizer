#!/usr/bin/env bash
# optimizer — daily launcher: bring the fund stack up (gated on the fund
# alembic-at-head healthcheck) and attach the Textual cockpit. Installed on PATH as
# a symlink (~/.local/bin/optimizer -> scripts/optimizer), so resolution follows the
# link back to the repo. Keep this file LF-only: a CRLF shebang fails under Git Bash
# and Linux containers.
set -euo pipefail

# Resolve the repo root, in precedence order:
#   1. $OPTIMIZER_REPO           — explicit override, self-heals a moved repo
#   2. the (possibly symlinked) $0 followed back to scripts/optimizer -> repo root
#   3. `repo_path` recorded in ~/.portopt/config.toml
resolve_repo() {
  if [[ -n "${OPTIMIZER_REPO:-}" && -f "${OPTIMIZER_REPO}/docker-compose.yml" ]]; then
    printf '%s\n' "${OPTIMIZER_REPO}"
    return 0
  fi

  # readlink loop: resolve symlinks one hop at a time — portable, since macOS lacks
  # `readlink -f`. $src ends at the real scripts/optimizer inside the repo.
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local target
    target="$(readlink "$src")"
    if [[ "$target" == /* ]]; then
      src="$target"
    else
      src="$(cd -P "$(dirname "$src")" && pwd)/${target}"
    fi
  done
  local script_dir repo
  script_dir="$(cd -P "$(dirname "$src")" && pwd)"
  repo="$(cd -P "${script_dir}/.." && pwd)"
  if [[ -f "${repo}/docker-compose.yml" ]]; then
    printf '%s\n' "$repo"
    return 0
  fi

  local cfg="${HOME}/.portopt/config.toml"
  if [[ -f "$cfg" ]]; then
    local from_cfg
    from_cfg="$(sed -n 's/^[[:space:]]*repo_path[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$cfg" | head -n1)"
    if [[ -n "$from_cfg" && -f "${from_cfg}/docker-compose.yml" ]]; then
      printf '%s\n' "$from_cfg"
      return 0
    fi
  fi

  echo "optimizer: cannot locate the repo (set OPTIMIZER_REPO)" >&2
  return 1
}

repo="$(resolve_repo)"
cd "$repo"

# db + fund; --wait blocks on the fund alembic-at-head healthcheck so the cockpit
# never attaches mid-migration.
docker compose --profile fund up -d --wait --wait-timeout 300

# Attach the cockpit. Under Git Bash mintty the console is not a real Windows
# console, so winpty bridges it to a TTY; elsewhere attach directly. Never pass
# `-T` — it disables the pseudo-TTY the Textual cockpit needs.
if [[ -n "${MSYSTEM:-}" && -t 0 && -t 1 ]] && command -v winpty >/dev/null 2>&1; then
  exec winpty docker compose --profile fund exec fund fund-tui "$@"
fi
exec docker compose --profile fund exec fund fund-tui "$@"
