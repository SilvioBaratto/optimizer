# ===========================================
# Portfolio Optimizer Environment Variables
# ===========================================

# Database (Local PostgreSQL via Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/optimizer_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=300
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false
DATABASE_COMMAND_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# ===========================================
# External API Keys
# ===========================================

# FRED (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# Trading 212 (HTTP Basic auth: Base64(API_KEY:SECRET_KEY) — both required)
# Get your key from: Trading 212 app > Settings > API
# Mode: "live" for real account, "demo" for paper trading account
# IMPORTANT: API keys are environment-scoped — a Demo key only works with mode=demo,
#            a Live key only works with mode=live. You cannot cross-use them.
TRADING_212_API_KEY=your-trading212-api-key
TRADING_212_SECRET_KEY=your-trading212-secret-key
TRADING_212_MODE=live

# Trading Economics
# Get your key at: https://tradingeconomics.com/api
TRADING_ECONOMICS_API_KEY=your-trading-economics-api-key

# ===========================================
# Fund bridge — LLM backend (SPEC D4, "Switchable LLM Backends")
# ===========================================
# The `fund` bridge picks its chat model from a provider registry. Set NOTHING
# and it stays on the verified default: DeepSeek on Ollama Cloud. To switch,
# set LLM_PROVIDER to one of: ollama | openai | openrouter | anthropic | google
# | groq | nvidia | huggingface | aws | microsoft, and supply that provider's
# auth below. Install the provider SDK with:
#   uv sync --package portopt-fund --extra <provider>   (or --extra all-llm)
#
# Model ids are SHARED across providers (one primary + one fallback). Switching
# provider usually means switching these too — an Ollama model id is meaningless
# to OpenAI. Defaults below are the Ollama Cloud DeepSeek pair.
LLM_PROVIDER=ollama
FUND_PRIMARY_MODEL=deepseek-v4.1-flash:cloud
FUND_FALLBACK_MODEL=deepseek-v4-pro:cloud

# --- ollama (default) — Ollama Cloud needs the key; a local daemon does not ---
# Local: set OLLAMA_BASE_URL=http://localhost:11434 and leave OLLAMA_API_KEY unset.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your-ollama-cloud-api-key

# --- openai (ChatOpenAI) — OPENAI_BASE_URL optional (self-host/proxy) ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=

# --- openrouter (ChatOpenAI at OpenRouter's base_url) ---
OPENROUTER_API_KEY=your-openrouter-api-key

# --- anthropic / google / groq (one cloud key each) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-genai-api-key
GROQ_API_KEY=your-groq-api-key

# --- nvidia — hosted (build.nvidia.com) needs the key; a self-hosted NIM sets
#     NVIDIA_BASE_URL and needs no key ---
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=

# --- huggingface — CLOUD ONLY (Inference API); FUND_HF_MODE=local is deferred ---
HUGGINGFACEHUB_API_TOKEN=your-hf-api-token
FUND_HF_MODE=cloud

# --- aws (Bedrock Converse) — region-scoped; creds via AWS_*/IAM, not a key.
#     boto3 honours AWS_CA_BUNDLE for corporate TLS ---
AWS_REGION=us-east-1

# --- microsoft (Azure OpenAI) — all four are required when LLM_PROVIDER=microsoft ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
