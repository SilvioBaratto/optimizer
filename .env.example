# ===========================================
# Portfolio Optimizer Environment Variables
# ===========================================

# Database (Local PostgreSQL via Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/optimizer_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=300
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false
# Server-side caps in milliseconds, applied by the ingestion daemon and the fund
# bridge. LOCK_TIMEOUT bounds how long a write waits behind another
# transaction's row lock (default 60000 when unset; 0 waits forever).
# STATEMENT_TIMEOUT bounds any single statement, lock waits included (default 0
# = no limit, since it would cancel legitimate bulk writes).
DATABASE_LOCK_TIMEOUT_MS=60000
# DATABASE_STATEMENT_TIMEOUT_MS=0

# Logging
LOG_LEVEL=INFO

# ===========================================
# External API Keys
# ===========================================

# FRED (Federal Reserve Economic Data)
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Left commented on purpose: a placeholder value would pass the "key is set"
# check and fail later with an opaque 400 instead of a clear "key required".
# FRED_API_KEY=

# Trading 212 (HTTP Basic auth: Base64(API_KEY:SECRET_KEY) — both required)
# Get your key from: Trading 212 app > Settings > API
# Mode: "live" for real account, "demo" for paper trading account
# IMPORTANT: API keys are environment-scoped — a Demo key only works with mode=demo,
#            a Live key only works with mode=live. You cannot cross-use them.
# Optional add-on: while the key is unset the t212_annotate step skips. Keep both
# keys commented until you have real values — a placeholder counts as "set".
# TRADING_212_API_KEY=
# TRADING_212_SECRET_KEY=
TRADING_212_MODE=live

# Trading Economics and Il Sole 24 Ore are scraped from HTML and need no API key.

# ===========================================
# Fund bridge — LLM backend (SPEC D4, "Switchable LLM Backends")
# ===========================================
# The `fund` bridge picks its chat model from a provider registry. Set NOTHING
# and it stays on the verified default: DeepSeek on Ollama Cloud. To switch,
# set LLM_PROVIDER to one of: ollama | openai | openrouter | anthropic | google
# | groq | nvidia | huggingface | aws | microsoft, and supply that provider's
# auth below. Install the provider SDK with:
#   uv sync --package portopt-fund --extra <provider>   (or --extra all-llm)
# `openrouter` and `microsoft` share the `openai` extra (--extra openai); `ollama`
# needs no extra.
#
# Model ids are SHARED across providers (one primary + one fallback). Switching
# provider usually means switching these too — an Ollama model id is meaningless
# to OpenAI. Defaults below are the Ollama Cloud DeepSeek pair.
LLM_PROVIDER=ollama
FUND_PRIMARY_MODEL=deepseek-v4.1-flash:cloud
FUND_FALLBACK_MODEL=deepseek-v4-pro:cloud

# Optional context bounding. deepagents compacts an agent's transcript at a
# fraction of the model's context window, else at 170000 tokens; a small-context
# model (e.g. a local 32k Ollama model) overflows first. Set a lower trigger, in
# tokens, to apply to the PM, the profiler and every subagent. Unset = deepagents'
# default; KEEP is the recent-message count that survives each compaction.
# FUND_SUMMARY_TOKEN_THRESHOLD=24000
# FUND_SUMMARY_MESSAGES_TO_KEEP=6

# --- ollama (default) — Ollama Cloud needs the key; a local daemon does not ---
# Local: set OLLAMA_BASE_URL=http://localhost:11434 and leave OLLAMA_API_KEY unset.
# A local server gets an explicit context window (tokens) so its small default does
# not silently truncate the agent prompt; raise it if the model has the memory for it.
OLLAMA_BASE_URL=https://ollama.com
# FUND_OLLAMA_NUM_CTX=32768
OLLAMA_API_KEY=your-ollama-cloud-api-key

# --- openai (ChatOpenAI) — OPENAI_BASE_URL optional (self-host/proxy); leave it
#     commented unless set: an exported blank value is an empty base URL ---
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=

# --- openrouter (ChatOpenAI at OpenRouter's base_url) ---
OPENROUTER_API_KEY=your-openrouter-api-key

# --- anthropic / google / groq (one cloud key each) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-genai-api-key
GROQ_API_KEY=your-groq-api-key

# --- nvidia — hosted (build.nvidia.com) needs NVIDIA_API_KEY; a self-hosted NIM sets
#     NVIDIA_BASE_URL and needs no key. NVIDIA_API_KEY goes only to NVIDIA's own
#     https API: a custom NVIDIA_BASE_URL never receives it (so a hosted key left in
#     this file cannot leak to a NIM). For a gateway at NVIDIA_BASE_URL that needs
#     the key, also set NVIDIA_BASE_URL_SEND_KEY=true ---
NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_BASE_URL=
# NVIDIA_BASE_URL_SEND_KEY=true

# --- huggingface — CLOUD ONLY (Inference API); FUND_HF_MODE=local is deferred ---
HUGGINGFACEHUB_API_TOKEN=your-hf-api-token
FUND_HF_MODE=cloud

# --- aws (Bedrock Converse) — region-scoped; creds via AWS_*/IAM, not a key.
#     boto3 honours AWS_CA_BUNDLE for corporate TLS ---
AWS_REGION=us-east-1

# --- microsoft (Azure OpenAI) — all four are required when LLM_PROVIDER=microsoft ---
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# Azure routes by deployment, not model id: set this to the deployment the fallback
# model runs on (same resource, endpoint and key; it may serve the same model as the
# primary), otherwise the fallback retries the primary's deployment.
# AZURE_OPENAI_FALLBACK_DEPLOYMENT_NAME=your-fallback-deployment-name
